# Required for voice-note transcription (server-side only, never exposed to the client).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required for match events/lineups/stats/xG/historical fixtures (Sofascore-backed).
# Sofascore blocks requests from Vercel's IPs outright, so these route through
# ScraperAPI's API-endpoint integration. Free trial covers 1,000 requests/month.
# Get a key at https://www.scraperapi.com/
SCRAPERAPI_KEY=

# Required for league standing + current injury list (Sportmonks free plan).
# Get a token at https://www.sportmonks.com/ (Football API, free plan).
SPORTMONKS_TOKEN=

# Required for login + synced notes/voice notes. Auto-provisioned by
# installing Vercel's free "Upstash for Redis" marketplace integration
# (Storage tab in the Vercel dashboard, or `vercel install upstash/upstash-kv`)
# — no separate account needed. `vercel env pull` fetches these locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for login — signs session cookies. Any long random string, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=
