#!/usr/bin/env python3
"""
Fetch SPFL fixtures (League + League Cup + Scottish Cup) for the current season.
Output: JSON {season, fixtures: [{date, kickoff, home, away, comp, homeScore, awayScore, state}]}
  comp: "League" | "League Cup" | "Scottish Cup"
League data comes from ESPN (via curl); cup data from ICS files in ~/Sync/quickshell/.
Results cached for 1 hour.
"""

import json, os, re, subprocess, sys, time
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME  = Path.home()
CACHE = HOME / ".cache" / "quickshell" / "spfl-fixtures.json"
LOCK  = HOME / ".cache" / "quickshell" / "spfl-fixtures.lock"
SYNC  = HOME / "Sync" / "quickshell"
CACHE_TTL = 3600

LEAGUE_CUP_ICS   = SYNC / "league-cup.ics"
SCOTTISH_CUP_ICS = SYNC / "scottish-cup.ics"

# Premiership teams — used to filter cup fixtures so we only show relevant games.
PREM_TEAMS = {
    "celtic", "rangers", "heart of midlothian", "hearts", "hibernian", "hibs",
    "aberdeen", "kilmarnock", "motherwell", "st mirren", "st. mirren",
    "st johnstone", "st. johnstone", "dundee united", "dundee", "dundee fc",
    "falkirk", "ross county", "livingston", "partick thistle",
    "inverness caledonian thistle", "inverness ct",
}

ABBREV = {
    "heart of midlothian":          "Hearts",
    "hearts of midlothian":         "Hearts",
    "hibernian":                    "Hibs",
    "dundee united":                "Dundee Utd",
    "inverness caledonian thistle": "Inverness CT",
    "inverness ct":                 "Inverness CT",
    "ross county":                  "Ross Co",
    "partick thistle":              "Partick",
    "livingston":                   "Livi",
    "queen of the south":           "QotS",
    "airdrieonians":                "Airdrie",
    "greenock morton":              "Morton",
    "st mirren":                    "St Mirren",
    "st. mirren":                   "St Mirren",
    "st johnstone":                 "St Johnstone",
    "st. johnstone":                "St Johnstone",
    "aberdeen":                     "Aberdeen",
    "rangers":                      "Rangers",
    "celtic":                       "Celtic",
    "motherwell":                   "Motherwell",
    "kilmarnock":                   "Kilmarnock",
    "falkirk":                      "Falkirk",
    "dundee":                       "Dundee",
    "dundee fc":                    "Dundee",
    "dunfermline athletic":         "Dunfermline",
    "ayr united":                   "Ayr United",
    "stenhousemuir":                "Stenhousemuir",
}


def abbrev(name):
    name = name.strip()
    k = name.lower()
    for suffix in (" fc", " f.c.", " football club"):
        if k.endswith(suffix):
            k = k[: -len(suffix)].strip()
    return ABBREV.get(k, name)


POSTPONED_STATUSES = {
    "STATUS_POSTPONED", "STATUS_CANCELED", "STATUS_SUSPENDED", "STATUS_ABANDONED",
}


def _is_postponed(status_type):
    return status_type.get("name", "") in POSTPONED_STATUSES


def is_prem(name):
    k = name.strip().lower()
    for suffix in (" fc", " f.c.", " football club"):
        if k.endswith(suffix):
            k = k[: -len(suffix)].strip()
    # Exact match only — substring matching let lower-league/junior sides whose
    # name happens to contain a Prem club's name (e.g. "Dundee North End"
    # containing "dundee", "Kilwinning Rangers" containing "rangers") slip
    # through as if they were the Prem side itself.
    return k in PREM_TEAMS


def season_year():
    now = datetime.now()
    return now.year if now.month >= 7 else now.year - 1


# ── ESPN league fixtures ──────────────────────────────────────────────────────

def _espn_events_for_range(start, end, slug="sco.1", extra=""):
    url = (
        f"https://site.api.espn.com/apis/site/v2/sports/soccer/{slug}"
        f"/scoreboard?limit=500&dates={start}-{end}{extra}"
    )
    r = subprocess.run(["curl", "-s", "--compressed", "--max-time", "20", url],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return []
    try:
        return json.loads(r.stdout).get("events", [])
    except Exception:
        return []


def _espn_event_to_fixture(e, comp_label=None):
    """Shared event -> fixture dict conversion. comp_label overrides the
    ESPN "League" default (used for UEFA competitions)."""
    comps = e.get("competitions", [])
    if not comps:
        return None
    comp = comps[0]
    competitors = comp.get("competitors", [])
    if len(competitors) < 2:
        return None
    home = next((c for c in competitors if c.get("homeAway") == "home"), competitors[0])
    away = next((c for c in competitors if c.get("homeAway") == "away"), competitors[1])
    status    = comp.get("status", {}).get("type", {})
    state     = status.get("state", "pre")
    completed = status.get("completed", False)
    postponed = _is_postponed(status)

    date_str = e.get("date", "")
    try:
        dt       = datetime.strptime(date_str, "%Y-%m-%dT%H:%MZ").replace(tzinfo=timezone.utc)
        local_dt = dt.astimezone()
        date_local = local_dt.strftime("%Y-%m-%d")
        kickoff    = local_dt.strftime("%H:%M")
    except Exception:
        date_local = date_str[:10]
        kickoff    = ""

    hs = home.get("score")
    as_ = away.get("score")
    return {
        "date":      date_local,
        "kickoff":   kickoff,
        "home":      abbrev(home.get("team", {}).get("displayName", "?")),
        "away":      abbrev(away.get("team", {}).get("displayName", "?")),
        "comp":      comp_label or "League",
        "homeScore": int(hs)  if completed and hs  is not None else None,
        "awayScore": int(as_) if completed and as_ is not None else None,
        "state":     state,
        "postponed": postponed,
    }


def fetch_espn():
    yr = season_year()
    # Fetch current season + previous season so recent results from the tail
    # of last season (e.g. May league games) are included.
    events = _espn_events_for_range(f"{yr}0701", f"{yr + 1}0630", extra="&seasontype=2")
    events += _espn_events_for_range(f"{yr - 1}0701", f"{yr}0630", extra="&seasontype=2")

    seen_ids = set()
    out = []
    for e in events:
        eid = e.get("id")
        if eid in seen_ids:
            continue
        seen_ids.add(eid)
        fixture = _espn_event_to_fixture(e)
        if fixture:
            out.append(fixture)
    return out


# ── UEFA European fixtures (Champions/Europa/Conference League, incl.
# qualifying rounds) for whichever Scottish teams are involved that season.
UEFA_SLUGS = [
    ("uefa.champions_qual",   "Champions League"),
    ("uefa.champions",        "Champions League"),
    ("uefa.europa_qual",      "Europa League"),
    ("uefa.europa",           "Europa League"),
    ("uefa.europa.conf_qual", "Conference League"),
    ("uefa.europa.conf",      "Conference League"),
]


def fetch_uefa():
    yr = season_year()
    seen_ids = set()
    out = []
    for slug, label in UEFA_SLUGS:
        # ESPN's scoreboard endpoint silently returns zero events for date
        # spans much beyond ~9 months, so split the season into two chunks
        # rather than querying it as one ~13-month range.
        events = _espn_events_for_range(f"{yr}0601", f"{yr}1231", slug=slug)
        events += _espn_events_for_range(f"{yr + 1}0101", f"{yr + 1}0630", slug=slug)
        for e in events:
            eid = e.get("id")
            if eid in seen_ids:
                continue
            comps = e.get("competitions", [])
            if not comps:
                continue
            competitors = comps[0].get("competitors", [])
            names = [c.get("team", {}).get("displayName", "") for c in competitors]
            if not any(is_prem(n) for n in names):
                continue
            seen_ids.add(eid)
            fixture = _espn_event_to_fixture(e, comp_label=label)
            if fixture:
                out.append(fixture)
    return out


# ── ESPN cup fixtures for the near-term window ──────────────────────────────
# The cup ICS files are synced in by another device scraping fotmob.com, and
# can sit stale — or simply be missing fixtures entirely — for days if that
# device hasn't run/synced recently. ESPN has no dedicated league slug for
# the Scottish cups, but its global "all" soccer scoreboard for a specific
# date does include them, tagged via altGameNote (e.g. "Scottish League Cup,
# Quarterfinals" / "Scottish Cup, Fourth Round") — distinct from the reserve-
# team "SPFL Challenge Cup" and normal league fixtures. Query it day-by-day
# across a rolling window and use it as the authoritative source for that
# window: it both refreshes stale ICS entries AND fills in fixtures the ICS
# doesn't have yet, so the cup list stays current without depending on the
# other device. limit=500 avoids the default 100-event cap silently dropping
# matches on busy fixture days.

REFRESH_WINDOW_DAYS_BACK    = 3
REFRESH_WINDOW_DAYS_FORWARD = 30

_espn_all_cache = {}

def _espn_all_for_date(date_local):
    key = date_local.replace("-", "")
    if key in _espn_all_cache:
        return _espn_all_cache[key]
    url = (
        f"https://site.api.espn.com/apis/site/v2/sports/soccer/all"
        f"/scoreboard?dates={key}&limit=500"
    )
    r = subprocess.run(["curl", "-s", "--compressed", "--max-time", "15", url],
                       capture_output=True, text=True)
    events = []
    if r.returncode == 0 and r.stdout.strip():
        try:
            events = json.loads(r.stdout).get("events", [])
        except Exception:
            events = []
    _espn_all_cache[key] = events
    return events


CUP_NOTE_LABELS = (
    ("Scottish League Cup", "League Cup"),
    ("Scottish Cup",        "Scottish Cup"),
)


def fetch_cup_fixtures_from_espn(days_back=REFRESH_WINDOW_DAYS_BACK,
                                  days_forward=REFRESH_WINDOW_DAYS_FORWARD):
    """Scottish League Cup / Scottish Cup fixtures involving a Prem team,
    for every day in [today-days_back, today+days_forward], keyed by
    (date, home, away) so callers can merge/override ICS-derived fixtures."""
    today = datetime.now().date()
    out = {}
    for offset in range(-days_back, days_forward + 1):
        date_local = (today + timedelta(days=offset)).strftime("%Y-%m-%d")
        for e in _espn_all_for_date(date_local):
            comps = e.get("competitions", [])
            if not comps:
                continue
            note = comps[0].get("altGameNote", "") or ""
            comp_label = next((label for prefix, label in CUP_NOTE_LABELS
                                if note.startswith(prefix)), None)
            if comp_label is None:
                continue
            fixture = _espn_event_to_fixture(e, comp_label=comp_label)
            if not fixture:
                continue
            if not (is_prem(fixture["home"]) or is_prem(fixture["away"])):
                continue
            key = (fixture["date"], fixture["home"].lower(), fixture["away"].lower())
            out[key] = fixture
    return out


# ── ICS cup fixtures ──────────────────────────────────────────────────────────

def parse_ics(path, comp_label):
    """Parse an ICS file and return fixtures involving at least one Prem team."""
    try:
        from icalendar import Calendar
    except ImportError:
        return []
    if not Path(path).exists():
        return []
    try:
        with open(path, "rb") as f:
            cal = Calendar.from_ical(f.read())
    except Exception:
        return []

    out = []
    for component in cal.walk():
        if component.name != "VEVENT":
            continue
        summary = str(component.get("SUMMARY", ""))
        # Strip emoji prefix and parse "Home - Away  (score)" or "Home - Away"
        summary = re.sub(r"^[^\w\-]+", "", summary).strip()
        m = re.match(r"(.+?)\s+-\s+(.+?)(?:\s+\((\d+)-(\d+)\))?$", summary)
        if not m:
            continue
        home_raw = m.group(1).strip()
        away_raw = m.group(2).strip()
        # Only include if at least one team is a Prem side
        if not (is_prem(home_raw) or is_prem(away_raw)):
            continue

        dtstart = component.get("DTSTART")
        if not dtstart:
            continue
        dt = dtstart.dt
        if not hasattr(dt, "hour"):  # all-day date — skip
            continue
        if hasattr(dt, "tzinfo") and dt.tzinfo:
            dt = dt.astimezone().replace(tzinfo=None)
        date_local = dt.strftime("%Y-%m-%d")
        kickoff    = dt.strftime("%H:%M")

        home_score_str = m.group(3)
        away_score_str = m.group(4)
        completed = home_score_str is not None
        # State: if score present it's finished, else pre (ICS doesn't expose live)
        state = "post" if completed else "pre"

        fixture = {
            "date":      date_local,
            "kickoff":   kickoff,
            "home":      abbrev(home_raw),
            "away":      abbrev(away_raw),
            "comp":      comp_label,
            "homeScore": int(home_score_str) if completed else None,
            "awayScore": int(away_score_str) if completed else None,
            "state":     state,
            "postponed": False,
        }
        out.append(fixture)
    return out


def merge_cup_fixtures(ics_fixtures, espn_window_fixtures):
    """Combine ICS-derived cup fixtures with the fresher ESPN window
    fixtures, letting ESPN win within its window (both to refresh stale
    scores/state and to add fixtures the ICS doesn't have yet) while keeping
    ICS-only fixtures (outside the window) untouched."""
    merged = {(f["date"], f["home"].lower(), f["away"].lower()): f for f in ics_fixtures}
    merged.update(espn_window_fixtures)
    return list(merged.values())


# ── Two-legged tie aggregates (UEFA qualifying rounds) ─────────────────────────
# Attach aggHome/aggAway to the second leg once the first leg has been played,
# oriented to match the second leg's own home/away so it reads naturally next
# to that fixture's score.

EUROPEAN_COMPS = {"Champions League", "Europa League", "Conference League"}


def _add_aggregates(fixtures):
    groups = {}
    for f in fixtures:
        if f["comp"] not in EUROPEAN_COMPS:
            continue
        key = (f["comp"], frozenset((f["home"], f["away"])))
        groups.setdefault(key, []).append(f)

    for legs in groups.values():
        if len(legs) != 2:
            continue
        legs.sort(key=lambda x: (x["date"], x["kickoff"]))
        leg1, leg2 = legs
        if leg1["homeScore"] is None or leg1["awayScore"] is None:
            continue
        if leg1["home"] != leg2["away"] or leg1["away"] != leg2["home"]:
            continue
        leg2["aggHome"] = leg1["awayScore"] + (leg2["homeScore"] or 0)
        leg2["aggAway"] = leg1["homeScore"] + (leg2["awayScore"] or 0)
    return fixtures


# ── Main ──────────────────────────────────────────────────────────────────────
# Cache is served instantly regardless of age so the widget never blocks on
# the network; a stale cache triggers a detached background refresh (this
# script re-invoking itself with --refresh) that overwrites the cache file
# for the *next* call. Callers can watch the "stale" field to know a refresh
# is (or should be) under way and poll again shortly after.

def _refresh_lock_held():
    if not LOCK.exists():
        return False
    try:
        pid = int(LOCK.read_text().strip())
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def do_refresh():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    LOCK.write_text(str(os.getpid()))
    try:
        cup_fixtures  = parse_ics(LEAGUE_CUP_ICS,   "League Cup")
        cup_fixtures += parse_ics(SCOTTISH_CUP_ICS, "Scottish Cup")
        cup_fixtures  = merge_cup_fixtures(cup_fixtures, fetch_cup_fixtures_from_espn())

        fixtures = fetch_espn()
        fixtures += cup_fixtures
        fixtures += fetch_uefa()
        fixtures = _add_aggregates(fixtures)
        fixtures.sort(key=lambda x: (x["date"], x["kickoff"]))
        yr = season_year()
        cached = {
            "season":    f"{yr}-{(yr + 1) % 100:02d}",
            "fixtures":  fixtures,
            "fetchedAt": time.time(),
        }
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(cached))
    except Exception:
        pass
    finally:
        try:
            LOCK.unlink()
        except Exception:
            pass


def _spawn_background_refresh():
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "--refresh"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main():
    if "--refresh" in sys.argv:
        do_refresh()
        return

    cached = None
    if CACHE.exists():
        try:
            cached = json.loads(CACHE.read_text())
        except Exception:
            cached = None

    if cached is None:
        # First run ever (no cache to show instantly) — fetch synchronously.
        do_refresh()
        if CACHE.exists():
            try:
                cached = json.loads(CACHE.read_text())
            except Exception:
                pass
        if cached is None:
            cached = {"season": "", "fixtures": [], "fetchedAt": 0}

    stale = (time.time() - cached.get("fetchedAt", 0)) > CACHE_TTL
    if stale and not _refresh_lock_held():
        _spawn_background_refresh()
    cached["stale"] = stale

    print(json.dumps(cached))


if __name__ == "__main__":
    main()
